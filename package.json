{
  "name": "react-pg",
  "version": "0.2.0",
  "private": true,
  "homepage": "https://endlessrequiem.github.io/portfolio-site",
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build/client",
    "build:static": "remix vite:build && cp -r build/client/* build/",
    "deploy:static": "npm run build:static && gh-pages -d build"
  },
  "dependencies": {
    "@remix-run/node": "^2.8.1",
    "@remix-run/react": "^2.8.1",
    "@remix-run/serve": "^2.8.1",
    "isbot": "^4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@remix-run/dev": "^2.8.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9",
    "gh-pages": "^6.3.0",
    "typescript": "^5",
    "vite": "^5.1.4"
  }
}
